rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function owns(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validImage() {
      return request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg', 'image/png', 'image/gif', 'image/webp'
        ];
    }

    function reservation(photoId) {
      return firestore.get(/databases/(default)/documents/photoReservations/$(photoId)).data;
    }

    match /recordPhotos/{kind}/{userId}/{recordId}/{photoId} {
      allow create: if owns(userId) && resource == null && validImage()
        && kind in ['items', 'events']
        && reservation(photoId).ownerUid == userId
        && reservation(photoId).kind == kind
        && reservation(photoId).recordId == recordId
        && reservation(photoId).path == 'recordPhotos/' + kind + '/' + userId + '/' + recordId + '/' + photoId
        && reservation(photoId).state == 'reserved'
        && request.time.toMillis() < reservation(photoId).expiresAt;
      allow get: if reservation(photoId).ownerUid == userId
        && reservation(photoId).kind == kind
        && reservation(photoId).recordId == recordId
        && reservation(photoId).state == 'attached';
      // Only the trusted lifecycle worker can delete; listing and updates are denied.
    }

    // Application uploads are flat: items/{userId}/{timestamp}_{filename}.
    match /items/{userId}/{fileName} {
      allow get: if true;
      allow create: if resource == null && owns(userId) && validImage();
      allow delete: if owns(userId);
    }

    // Application uploads are flat: events/{userId}/{timestamp}_{filename}.
    match /events/{userId}/{fileName} {
      allow get: if true;
      allow create: if resource == null && owns(userId) && validImage();
      allow delete: if owns(userId);
    }
  }
}
