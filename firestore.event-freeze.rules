rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validEvent(data) {
      return data.keys().hasAll([
          'userId', 'title', 'description', 'location', 'locationVisibility',
          'startDate', 'endDate', 'photoURL', 'createdAt', 'updatedAt',
          'itemCount'
        ])
        && data.keys().hasOnly([
          'userId', 'title', 'description', 'location', 'locationVisibility',
          'address', 'startDate', 'endDate', 'photoURL', 'createdAt',
          'updatedAt', 'itemCount'
        ])
        && data.userId is string
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && data.description is string
        && data.description.size() <= 5000
        && data.location is string
        && data.location.size() > 0
        && data.locationVisibility in ['general', 'exact']
        && data.startDate is timestamp
        && data.endDate is timestamp
        && data.endDate > data.startDate
        && (data.photoURL == null || data.photoURL is string)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.itemCount is int
        && data.itemCount >= 0
        && (
          (data.locationVisibility == 'general'
            && !data.keys().hasAny(['address']))
          ||
          (data.locationVisibility == 'exact'
            && data.keys().hasAny(['address'])
            && data.address is string
            && data.address.size() > 0
            && data.address.size() <= 300)
        );
    }

    // Users collection - owner-only reads; keep existing write policies
    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId ||
                       (request.auth != null &&
                        request.resource.data.keys().hasOnly(['averageRating', 'totalReviews', 'ratingBreakdown']) &&
                        request.resource.data.averageRating >= 0 && request.resource.data.averageRating <= 5 &&
                        request.resource.data.totalReviews >= 0);
      allow delete: if request.auth.uid == userId;
    }

    match /publicProfiles/{uid} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /usernameClaims/{canonicalUsername} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /usernameState/{uid} {
      allow read, write: if false;
    }

    match /reservedUsernames/{canonicalUsername} {
      allow read, write: if false;
    }

    // Items collection - anyone can read, only creator can write
    match /items/{itemId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth.uid == resource.data.userId;
    }

    match /yardSaleEvents/{eventId} {
      allow get: if validEvent(resource.data)
        || owns(resource.data.userId);
      allow list: if owns(resource.data.userId);
      allow create, update, delete: if false;
    }

    // This collection did not exist in the supplied production rules.
    match /eventPrivate/{eventId} {
      allow create, update, delete: if false;
    }

    // Messages - only participants can read, only sender can create
    match /messages/{messageId} {
      allow read: if request.auth.uid == resource.data.senderId ||
                     request.auth.uid == resource.data.recipientId;
      allow create: if request.auth.uid == request.resource.data.senderId;
    }

    // Favorites - only owner can read and write
    match /favorites/{favoriteId} {
  allow read: if request.auth != null;
  allow create: if request.auth.uid == request.resource.data.userId &&
                   request.resource.data.type in ['item', 'seller', 'event'] &&
                   favoriteId == request.resource.data.userId + '_' + request.resource.data.type + '_' + request.resource.data.targetId;
  allow delete: if request.auth.uid == resource.data.userId;
}

    // Reviews - authenticated users can read, reviewers can create/update/delete
    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.reviewerId &&
                       request.resource.data.reviewerId != request.resource.data.sellerId &&
                       request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       request.resource.data.comment.size() <= 500 &&
                       reviewId == request.resource.data.sellerId + '_' + request.resource.data.reviewerId;
      allow update: if request.auth.uid == resource.data.reviewerId;
      allow delete: if request.auth.uid == resource.data.reviewerId;
    }
  }
}